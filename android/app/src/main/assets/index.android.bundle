ant stillness"},healing_clean_space:{title:"Liquid Peace",desc:"Flowing like water"},healing_crystal:{title:"Crystal Bowl",desc:"High frequency resonance"},brainwave_alpha:{title:"Alpha Focus",desc:"Focus and relaxation"},brainwave_delta:{title:"Delta Sleep",desc:"Binaural synchronization"},interactive_white_noise:{title:"White Noise",desc:"Deep concentration"},interactive_wind_chime:{title:"Wind Chimes",desc:"Ethereal sounds"},interactive_breath:{title:"Breathing",desc:"Mindfulness guidance"},interactive_apple:{title:"Apple Crunch",desc:"Relaxing sound"},interactive_match:{title:"Match Strike",desc:"Trigger sound"},western_church_gregorian:{title:"Gregorian Chant",desc:"Ancient Gregorian chants in a cathedral"},western_church_morning_bell:{title:"Morning Bell",desc:"Morning bells from the monastery"},western_church_holy_waves:{title:"Holy Light",desc:"Spiritual convergence of light and sound"},western_church_forest_echo:{title:"Stone Corridor Echo",desc:"Echoes from an ancient monastery"},western_church_urban_chant:{title:"Candlelight Meditation",desc:"Peaceful chants in candlelight"},oriental_zen_monastery:{title:"Zen Monastery",desc:"Ancient temple bells, calm mind"},oriental_tibetan_bowl:{title:"Tibetan Bowl",desc:"High-frequency resonance, purify the soul"},oriental_morning_buddha:{title:"Morning Buddha",desc:"Morning bells and evening drums, deep zen"}},disclaimer:{title:"Health Disclaimer",content:"The audio content provided by this app is for relaxation and meditation purposes only and cannot replace professional medical advice, diagnosis, or treatment. Please consult a healthcare professional for any health concerns."},noise_breeze_title:"Gentle Breeze",noise_breeze_desc:"Silky smooth white noise to calm your mind and find peace.",noise_downpour_title:"Heavy Downpour",noise_downpour_desc:"Enveloping rain noise to shield you from external distractions.",noise_fireplace_title:"Cozy Fireplace",noise_fireplace_desc:"The warm crackle of a fireplace, creating a s